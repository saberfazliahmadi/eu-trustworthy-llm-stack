# Provider: mock (default, offline & deterministic) | openai (any OpenAI-compatible endpoint) | hf (local transformers)
LLM_PROVIDER=mock

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# --- Google Gemini via OpenAI-compatible endpoint ---
# OPENAI_API_KEY=your-gemini-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# EMBED_MODEL=text-embedding-004

# --- Ollama (local) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# EMBED_MODEL=nomic-embed-text

# --- Hugging Face local ---
# HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Guard backend: heuristic (default) | llm (LlamaGuard-style prompt through the configured provider)
GUARD_BACKEND=heuristic
SEED=42
LOG_LEVEL=INFO
